<mxfile host="app.diagrams.net" agent="Database Course Design">
  <diagram name="销售与客户模块局部E-R图" id="local-sales-customer-er">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="销售与客户模块局部E-R图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="30" width="400" height="40" as="geometry" />
        </mxCell>

        <mxCell id="customers" value="客户&lt;br&gt;&lt;u&gt;客户ID&lt;/u&gt;&lt;br&gt;姓名 / 手机号 / 身份证号&lt;br&gt;来源渠道 / 首次到店日期" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="intentions" value="客户意向&lt;br&gt;&lt;u&gt;意向ID&lt;/u&gt;&lt;br&gt;意向级别 / 备注&lt;br&gt;下次联系时间" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="130" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="models" value="车型&lt;br&gt;&lt;u&gt;车型ID&lt;/u&gt;&lt;br&gt;车系 / 年款 / 配置&lt;br&gt;指导价 / 车型类型" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="790" y="120" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="employees" value="员工&lt;br&gt;&lt;u&gt;员工ID&lt;/u&gt;&lt;br&gt;工号 / 姓名 / 角色&lt;br&gt;部门 / 上级主管" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="790" y="500" width="190" height="110" as="geometry" />
        </mxCell>
        <mxCell id="orders" value="销售订单&lt;br&gt;&lt;u&gt;订单号&lt;/u&gt;&lt;br&gt;总金额 / 定金 / 付款方式&lt;br&gt;订单状态 / 创建时间 / 交车时间" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="490" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="order_items" value="订单明细&lt;br&gt;&lt;u&gt;明细ID&lt;/u&gt;&lt;br&gt;明细类型 / 项目描述 / 金额" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="450" y="720" width="190" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rel_owns" value="拥有" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1" vertex="1" parent="1">
